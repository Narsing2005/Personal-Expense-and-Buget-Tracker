# Finora Environment Configuration Template

FLASK_APP=app.py
FLASK_DEBUG=True
PORT=5000
HOST=0.0.0.0

# Security Secrets
SECRET_KEY=finora-change-this-secret-key-in-production-2026
JWT_SECRET_KEY=finora-jwt-secret-key-secure-enterprise-grade-32-chars!

# MongoDB Connection
# Set your MongoDB connection URI (e.g., local MongoDB or MongoDB Atlas cluster)
MONGO_URI=mongodb://localhost:27017/finora_db
DB_NAME=finora_db
